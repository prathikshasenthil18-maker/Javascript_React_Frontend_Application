{
  "threshold": 0,
  "reporters": ["json", "console"],
  "ignore": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/.nyc_output/**",
    "**/dist/**",
    "**/reports/**"
  ],
  "format": ["javascript", "jsx", "typescript", "tsx", "vue"],
  "absolute": false,
  "gitignore": true,
  "minLines": 5,
  "minTokens": 50
}
